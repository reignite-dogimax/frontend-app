# API Configuration
VITE_API_URL=https://your-api-domain.com
VITE_PRODUCTION=true

# API Endpoints - Usually don't need to change these
VITE_APPOINTMENTS_ENDPOINT=/api/v1/appointments
VITE_VETERINARIES_ENDPOINT=/api/v1/veterinarys
VITE_PETS_ENDPOINT=/api/v1/pets
VITE_MEDICAL_HISTORIES_ENDPOINT=/api/v1/medical-histories
VITE_RECOMMENDATIONS_ENDPOINT=/api/v1/recommendations
VITE_NOTIFICATIONS_ENDPOINT=/api/v1/notifications

# External Services
VITE_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/your-webhook-id